# ==========================================
# AI Drone Swarm Commander Configuration
# ==========================================

# Google Gemini API Key (Required for natural language intent parsing)
# If omitted or invalid, the server automatically falls back to deterministic regex NLP.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Specific Gemini model override (defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# WebSocket Auth Token (Required to prevent unauthorized drone command injections)
# Keep this secret! WebSocket clients must pass it via 'Authorization: Bearer <token>'.
WS_AUTH_TOKEN=super_secret_auth_token_123

# HTTP Server Address (Default is :8080)
HTTP_ADDR=:8080

# Rate Limiting & WebSocket Guardrails
WS_RATE_PER_MIN=600
WS_MAX_MSG_BYTES=65536
